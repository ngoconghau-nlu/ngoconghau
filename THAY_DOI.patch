+
+  // 13 Khoa & Đơn vị chính thức của ĐH Nông Lâm TP.HCM
+  const FACULTY_CODES = useMemo(() => [
+    'CNTT', 'CNTY', 'KT', 'KHSH', 'CKCN', 'CNHTP',
+    'LN', 'MTTN', 'NNSP', 'NH', 'QLDDBDS', 'TS', 'VC_NLD'
+  ], []);
+
+  // Tính toán kết quả thi đua 13 Khoa & Đơn vị tương đương
+  const facultyEmulationData = useMemo(() => {
