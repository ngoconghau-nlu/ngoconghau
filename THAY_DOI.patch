+import React from 'react';
+import { AppHeader } from './header/AppHeader';
+import { CustomNavItem } from '../types';
+import {
+  CANONICAL_NAVIGATION_CONFIG,
+  ICON_REGISTRY
+} from '../config/navigationConfig';
+
+// Re-export AppHeader and all subcomponents
+export { AppHeader } from './header/AppHeader';
+export { BrandSection } from './header/BrandSection';
+export { DesktopNavigation } from './header/DesktopNavigation';
+export { MobileNavigationDrawer } from './header/MobileNavigationDrawer';
+export { NavigationGroup } from './header/NavigationGroup';
+export { NavigationItem } from './header/NavigationItem';
+export { HeaderActions } from './header/HeaderActions';
+export { UserProfileMenu } from './header/UserProfileMenu';
+export { NavigationSearch } from './header/NavigationSearch';
+
+// Backward compatibility exports
+export const SECTION_SUMMARIES: Record<string, { summary: string; badge: string; permission: string }> = Object.fromEntries(
+  CANONICAL_NAVIGATION_CONFIG.map(item => [
+    item.id,
+    {
+      summary: item.description,
+      badge: item.badge,
+      permission: item.permissionLabel
+    }
+  ])
+);
+
+export const getSectionInfo = (item: CustomNavItem) => {
+  if (item.externalUrl) {
+    return {
+      summary: item.description || `Liên kết ngoài: Chuyển hướng đến ${item.externalUrl}`,
+      badge: 'Liên Kết Ngoài',
+      permission: 'Công khai'
+    };
+  }
+  const defaultInfo = SECTION_SUMMARIES[item.id];
+  if (defaultInfo) {
+    return {
+      ...defaultInfo,
+      summary: item.description || defaultInfo.summary
+    };
+  }
+  return {
+    summary: item.description || `Truy cập phân hệ ${item.label} trong hệ thống NLU Youth 2026.`,
+    badge: 'Phân Hệ',
+    permission: item.minLevel === 0 ? 'Công khai' : `Cấp ${item.minLevel}+`
+  };
+};
+
+export interface SubMenuItemConfig {
+  id: string;
+  label: string;
+  subLabel?: string;
+  targetTab: string;
+  icon: React.ComponentType<{ className?: string }>;
+  badge?: string;
+  badgeColor?: string;
+}
+
+export const SUB_MENU_MAP: Record<string, SubMenuItemConfig[]> = Object.fromEntries(
+  CANONICAL_NAVIGATION_CONFIG
+    .filter(item => Boolean(item.subItems && item.subItems.length > 0))
+    .map(item => [
+      item.id,
+      (item.subItems || []).map(sub => ({
+        id: sub.id,
+        label: sub.label,
+        subLabel: sub.subLabel,
+        targetTab: sub.targetTab,
+        icon: ICON_REGISTRY[sub.iconName] || ICON_REGISTRY['Link'],
+        badge: sub.badge,
+        badgeColor: sub.badgeColor
+      }))
+    ])
+);
+
+export const Header: React.FC = AppHeader;
+export default Header;
