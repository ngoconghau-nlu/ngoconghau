+      width: 50%;
+      font-size: 10pt;
+    }
+    .sign-title {
+      font-weight: bold;
+      text-transform: uppercase;
+      margin-bottom: 2px;
+    }
+    .sign-sub {
+      font-style: italic;
+      font-size: 8.5pt;
+      color: #4b5563;
+      margin-bottom: 45px;
+    }
+    .sign-name {
+      font-weight: bold;
+      font-size: 10.5pt;
+    }
+    .meta-bar {
+      margin-top: 15px;
+      padding-top: 6px;
+      border-top: 1px dashed #cbd5e1;
+      display: flex;
+      justify-content: space-between;
+      font-size: 8pt;
+      color: #6b7280;
+    }
+    @media print {
+      body {
+        padding: 0;
+      }
+      .no-print {
+        display: none !important;
+      }
+    }
+  </style>
+</head>
+<body>
+
+  <!-- Formal Youth Union Header -->
+  <table class="header-table">
+    <tr>
+      <td style="width: 48%;">
+        <div class="unit-title">${unitName}</div>
+        <div class="sub-unit">${subTitle}</div>
+        <div class="line-divider"></div>
+        <div class="doc-number">Mã văn bản: ${reportCode}</div>
+      </td>
+      <td style="width: 4%;"></td>
+      <td style="width: 48%;">
+        <div class="motto-title">ĐOÀN TNCS HỒ CHÍ MINH</div>
+        <div class="motto-sub">BAN CHẤP HÀNH ĐOÀN TRƯỜNG</div>
+        <div class="line-divider"></div>
+        <div class="date-line">${dateStr}</div>
