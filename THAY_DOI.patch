+
+// Code-splitting with React.lazy for major views
+const ActivityManagement = lazy(() => import('./components/ActivityManagement').then(m => ({ default: m.ActivityManagement })));
+const StudentPortal = lazy(() => import('./components/StudentPortal').then(m => ({ default: m.StudentPortal })));
+const ScoreRoster = lazy(() => import('./components/ScoreRoster').then(m => ({ default: m.ScoreRoster })));
+const OrganizationDirectory = lazy(() => import('./components/OrganizationDirectory').then(m => ({ default: m.OrganizationDirectory })));
+const AccountManagement = lazy(() => import('./components/AccountManagement').then(m => ({ default: m.AccountManagement })));
+const CertificateManagement = lazy(() => import('./components/CertificateManagement').then(m => ({ default: m.CertificateManagement })));
+const TargetManagement = lazy(() => import('./components/TargetManagement').then(m => ({ default: m.TargetManagement })));
+const GoogleDriveExplorer = lazy(() => import('./components/GoogleDriveExplorer').then(m => ({ default: m.GoogleDriveExplorer })));
+const SystemActivityLogView = lazy(() => import('./components/SystemActivityLogView').then(m => ({ default: m.SystemActivityLogView })));
+const ScoringCatalogsManagement = lazy(() => import('./components/ScoringCatalogsManagement').then(m => ({ default: m.ScoringCatalogsManagement })));
+const StudentCheckIn = lazy(() => import('./components/StudentCheckIn').then(m => ({ default: m.StudentCheckIn })));
+import { verifySync, VerifySyncResult } from './utils/verifySync';
+import {
+  LogIn,
+  ShieldAlert,
+  Sparkles,
+  ArrowRight,
+  LogOut,
+  Key,
+  AlertTriangle,
+  RefreshCw,
+  ChevronRight,
+  X
+} from 'lucide-react';
+
+const SsoAuthGate: React.FC = () => {
+  const { googleUser, loginGoogle, logoutGoogle, isConnectingGoogle, setActiveTab, activeTab } = useApp();
+
+  const getTabTitle = () => {
+    switch (activeTab) {
+      case 'targets': return 'Danh Mục Chỉ Tiêu & Đánh Giá Thông Minh';
+      case 'activities': return 'Quản Lý Hoạt Động & Đăng Ký Kế Hoạch';
+      case 'student-portal': return 'Cổng Sinh Viên & Nộp Minh Chứng SV5T';
+      case 'score-roster': return 'Danh Mục & Sổ Điểm Rèn Luyện Sinh Viên';
+      case 'faculty-emulation': return 'Bảng Xếp Hạng Thi Đua Đoàn Khoa';
+      case 'branch-emulation': return 'Bảng Xếp Hạng & Thi Đua Chi Đoàn';
+      case 'club-emulation': return 'Bảng Xếp Hạng & Thi Đua CLB, Tổ, Đội Nhóm';
+      case 'organizations': return 'Danh Mục Đơn Vị Đoàn - Hội';
