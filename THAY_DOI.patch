@@ -0,0 +1,405 @@
+import React, { useState, useEffect } from 'react';
+import {
+  X,
+  ChevronDown,
+  ExternalLink,
+  Sun,
+  Moon,
+  HelpCircle,
+  Edit2,
+  ShieldAlert,
+  CloudUpload,
+  LogOut,
+  LogIn,
+  Search,
+  Sparkles
+} from 'lucide-react';
+import { useApp } from '../../context/AppContext';
+import { CANONICAL_NAVIGATION_CONFIG, getCanonicalItem, resolveIcon } from '../../config/navigationConfig';
+import { CustomNavItem } from '../../types';
+
+interface MobileNavigationDrawerProps {
+  isOpen: boolean;
+  onClose: () => void;
+  onOpenHelp: () => void;
+  onOpenLogoEditor: () => void;
+  onOpenTrash: () => void;
+  onOpenBackup: () => void;
+  onOpenSearch: () => void;
+}
+
+export const MobileNavigationDrawer: React.FC<MobileNavigationDrawerProps> = ({
+  isOpen,
+  onClose,
+  onOpenHelp,
+  onOpenLogoEditor,
+  onOpenTrash,
+  onOpenBackup,
+  onOpenSearch
+}) => {
+  const {
+    user,
+    googleUser,
+    loginGoogle,
+    logoutGoogle,
+    theme,
+    toggleTheme,
+    activeTab,
+    setActiveTab,
+    customNavItems,
+    headerBranding
+  } = useApp();
+
+  const isDarkMode = theme === 'dark';
+
+  // Find which item contains activeTab to auto-expand that accordion!
+  const defaultExpandedId = React.useMemo(() => {
+    for (const item of CANONICAL_NAVIGATION_CONFIG) {
+      if (item.subItems && item.subItems.some(sub => sub.targetTab === activeTab)) {
+        return item.id;
+      }
+    }
+    return activeTab;
+  }, [activeTab]);
+
+  const [expandedNavId, setExpandedNavId] = useState<string | null>(defaultExpandedId);
+
+  // Auto-expand group containing active tab when activeTab changes or drawer opens
+  useEffect(() => {
+    if (isOpen) {
+      setExpandedNavId(defaultExpandedId);
+    }
+  }, [isOpen, defaultExpandedId]);
+
+  // Close on Escape key
+  useEffect(() => {
+    const handleKeyDown = (e: KeyboardEvent) => {
+      if (e.key === 'Escape') onClose();
+    };
+    if (isOpen) {
+      document.addEventListener('keydown', handleKeyDown);
+    }
+    return () => document.removeEventListener('keydown', handleKeyDown);
+  }, [isOpen, onClose]);
+
+  if (!isOpen) return null;
+
+  // Merge custom items
+  const visibleNavItems = React.useMemo<CustomNavItem[]>(() => {
+    const rawItems: CustomNavItem[] = customNavItems && customNavItems.length > 0
+      ? customNavItems
+      : CANONICAL_NAVIGATION_CONFIG.map(c => ({
+          id: c.id,
+          label: c.label,
+          iconName: c.iconName,
+          visible: true,
+          minLevel: c.minLevel,
+          order: c.order,
+          description: c.description
+        }));
+
+    return [...rawItems]
+      .sort((a, b) => (a.order || 0) - (b.order || 0))
+      .filter(item => item.visible !== false);
+  }, [customNavItems]);
+
+  const handleSelectTab = (targetTab: string) => {
+    setActiveTab(targetTab);
+    onClose();
+  };
