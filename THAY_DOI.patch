+        className="group relative inline-flex items-center justify-center gap-1 lg:gap-1.5 h-8 lg:h-8.5 px-2.5 lg:px-3 text-[11.5px] lg:text-xs font-semibold rounded-xl whitespace-nowrap text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-white dark:hover:bg-slate-800 transition-all duration-150 ease-out hover:scale-[1.02] active:scale-[0.98] cursor-pointer border border-transparent hover:border-slate-200 dark:hover:border-slate-700 hover:shadow-2xs shrink-0 select-none"
+      >
+        <span className="flex items-center justify-center w-3.5 h-3.5 shrink-0 text-slate-500 dark:text-slate-400 group-hover:scale-110 transition-transform duration-200">
+          <IconComponent className="w-3.5 h-3.5" />
