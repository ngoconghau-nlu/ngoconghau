@@ -0,0 +1,269 @@
+import React, { useState, useEffect, useRef } from 'react';
+import {
+  Settings2,
+  ChevronDown,
+  Layers,
+  BookOpen,
+  Building2,
+  Sliders,
+  Award,
+  CheckSquare,
+  FileText
+} from 'lucide-react';
+import { useApp } from '../../context/AppContext';
+import { CustomNavItem } from '../../types';
+import {
+  CANONICAL_NAVIGATION_CONFIG,
+  getCanonicalItem
+} from '../../config/navigationConfig';
+import { NavigationItem } from './NavigationItem';
+import { NavigationGroup } from './NavigationGroup';
+
+interface DesktopNavigationProps {
+  onOpenMenuEditor: (tab?: string) => void;
+  onOpenSearch: () => void;
+}
+
+export const DesktopNavigation: React.FC<DesktopNavigationProps> = ({
+  onOpenMenuEditor
+}) => {
+  const {
+    activeTab,
+    setActiveTab,
+    customNavItems,
+    user
+  } = useApp();
+
+  const [openSubmenuId, setOpenSubmenuId] = useState<string | null>(null);
+  const [configDropdownOpen, setConfigDropdownOpen] = useState(false);
+  const [hoveredNav, setHoveredNav] = useState<CustomNavItem | null>(null);
+  const [tooltipAnchor, setTooltipAnchor] = useState<{ x: number; y: number } | null>(null);
+  const navContainerRef = useRef<HTMLDivElement>(null);
+
+  const isLevel4 = user.currentRole.roleLevel === 4;
+
+  // Merge custom nav items with canonical items to preserve order, overrides and visibility
+  const visibleNavItems = React.useMemo(() => {
+    const rawItems = customNavItems && customNavItems.length > 0 ? customNavItems : CANONICAL_NAVIGATION_CONFIG.map(c => ({
+      id: c.id,
+      label: c.label,
+      iconName: c.iconName,
+      visible: true,
+      minLevel: c.minLevel,
+      order: c.order,
+      description: c.description
+    }));
+
+    const sorted = [...rawItems].sort((a, b) => (a.order || 0) - (b.order || 0));
+    return sorted.filter(item => item.visible !== false);
+  }, [customNavItems]);
+
+  // Dismiss tooltip immediately when page or container is scrolled
+  useEffect(() => {
+    if (!hoveredNav) return;
+    const dismiss = () => setHoveredNav(null);
+    window.addEventListener('scroll', dismiss, { passive: true });
+    return () => window.removeEventListener('scroll', dismiss);
+  }, [hoveredNav]);
+
+  // Close sub-menu & config dropdown on outside click or scroll
+  useEffect(() => {
+    const handleClickOutside = (e: MouseEvent) => {
+      const target = e.target as HTMLElement;
+      if (!target.closest('.submenu-container') && !target.closest('.config-container')) {
+        setOpenSubmenuId(null);
+        setConfigDropdownOpen(false);
+      }
+    };
+    const handleScroll = () => {
+      setOpenSubmenuId(null);
+      setConfigDropdownOpen(false);
+    };
+    document.addEventListener('mousedown', handleClickOutside);
+    window.addEventListener('scroll', handleScroll, { passive: true });
+    return () => {
+      document.removeEventListener('mousedown', handleClickOutside);
+      window.removeEventListener('scroll', handleScroll);
+    };
+  }, []);
+
+  const handleSelectNav = (targetTabId: string) => {
+    setActiveTab(targetTabId);
+    setOpenSubmenuId(null);
+    setHoveredNav(null);
+  };
+
+  return (
+    <div className="hidden md:block border-t border-slate-200/70 dark:border-slate-800/80 bg-slate-50/75 dark:bg-slate-900/80 backdrop-blur-xs relative z-30 transition-colors">
+      <div className="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 flex items-center justify-between gap-2 py-1 min-w-0" ref={navContainerRef}>
+        {/* Streamlined Horizontal Navigation Menu */}
+        <div className="flex items-center flex-wrap gap-0.5 sm:gap-1 lg:gap-1.5 flex-1 min-w-0 relative py-0.5 overflow-visible">
+          {visibleNavItems.map(item => {
+            const canonical = getCanonicalItem(item.id);
+            const subItems = canonical?.subItems;
+
+            // Check if active (either direct match or one of subItems matches activeTab)
+            const isDirectActive = activeTab === item.id;
+            const isSubActive = Boolean(
+              subItems && subItems.some(sub => sub.targetTab === activeTab)
+            );
+            const isActive = isDirectActive || isSubActive;
+            const isSubMenuOpen = openSubmenuId === item.id;
+
+            const handleMouseEnter = (e: React.MouseEvent<HTMLElement>) => {
+              const rect = e.currentTarget.getBoundingClientRect();
+              setHoveredNav(item);
+              setTooltipAnchor({
+                x: Math.max(140, Math.min(window.innerWidth - 140, rect.left + rect.width / 2)),
+                y: rect.bottom + 8
+              });
+            };
+
+            const handleFocus = (e: React.FocusEvent<HTMLElement>) => {
+              const rect = e.currentTarget.getBoundingClientRect();
+              setHoveredNav(item);
+              setTooltipAnchor({
+                x: Math.max(140, Math.min(window.innerWidth - 140, rect.left + rect.width / 2)),
+                y: rect.bottom + 8
+              });
+            };
+
+            // If item has subItems, delegate to NavigationGroup
+            if (subItems && subItems.length > 0) {
+              return (
+                <NavigationGroup
+                  key={item.id}
+                  item={item}
+                  configItem={canonical}
+                  subItems={subItems}
+                  isActive={isActive}
+                  isOpen={isSubMenuOpen}
+                  onToggle={() => {
+                    setOpenSubmenuId(isSubMenuOpen ? null : item.id);
+                    setHoveredNav(null);
+                  }}
+                  onClose={() => setOpenSubmenuId(null)}
+                  onSelectParent={handleSelectNav}
+                  onSelectSubItem={handleSelectNav}
+                  onMouseEnter={handleMouseEnter}
+                  onMouseLeave={() => setHoveredNav(null)}
+                  onFocus={handleFocus}
+                  onBlur={() => setHoveredNav(null)}
+                />
+              );
+            }
+
+            // Otherwise, render single NavigationItem
+            return (
+              <NavigationItem
+                key={item.id}
+                item={item}
+                configItem={canonical}
+                isActive={isActive}
+                onSelect={handleSelectNav}
+                onMouseEnter={handleMouseEnter}
+                onMouseLeave={() => setHoveredNav(null)}
+                onFocus={handleFocus}
+                onBlur={() => setHoveredNav(null)}
+              />
+            );
+          })}
+        </div>
+
+        {/* Level 4 System Configuration Dropdown */}
+        {isLevel4 && (
+          <div className="relative shrink-0 z-40 config-container">
+            <button
+              type="button"
+              onClick={() => setConfigDropdownOpen(!configDropdownOpen)}
+              className="flex items-center gap-1 sm:gap-1.5 h-8 lg:h-8.5 px-2.5 sm:px-3 text-[11.5px] lg:text-xs font-bold text-amber-900 dark:text-amber-200 bg-amber-100/90 dark:bg-amber-950/70 hover:bg-amber-200 dark:hover:bg-amber-900/80 border border-amber-300/80 dark:border-amber-700/80 rounded-xl transition-all duration-150 ease-out hover:scale-[1.02] active:scale-[0.98] cursor-pointer shadow-2xs shrink-0"
+              title="Truy cập danh mục cấu hình hệ thống & quy chế chấm điểm (Cấp 4)"
+              aria-expanded={configDropdownOpen}
+            >
+              <Settings2 className="w-3.5 h-3.5 text-amber-700 dark:text-amber-400 shrink-0" />
+              <span className="hidden lg:inline">Cấu Hình Cấp 4</span>
+              <ChevronDown className={`w-3 h-3 opacity-70 shrink-0 transition-transform duration-200 ${configDropdownOpen ? 'rotate-180' : ''}`} />
+            </button>
+
+            {configDropdownOpen && (
+              <div className="absolute right-0 top-full mt-2 w-72 sm:w-80 bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 ring-1 ring-black/5 dark:ring-white/10 z-50 py-2 divide-y divide-slate-100 dark:divide-slate-800 animate-in fade-in zoom-in-95 duration-150">
+                <div className="px-3 py-2 flex items-center justify-between">
+                  <p className="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 dark:text-amber-400">
+                    Cấu Hình & Danh Mục Cấp 4
+                  </p>
+                  <span className="text-[9px] bg-amber-100 dark:bg-amber-900 text-amber-800 dark:text-amber-300 px-1.5 py-0.5 rounded font-mono font-bold">
+                    Admin Cấp Trường
+                  </span>
+                </div>
+                <div className="p-1.5 space-y-0.5 max-h-[60vh] overflow-y-auto">
+                  {[
+                    { id: 'menu', label: '1. Menu Điều Hướng Hệ Thống', icon: Layers },
+                    { id: 'dictionary', label: '2. Từ Ngữ Hệ Thống & Cụm Từ', icon: BookOpen },
+                    { id: 'organizations', label: '3. Đơn Vị Tổ Chức (53 NLU)', icon: Building2 },
+                    { id: 'scales', label: '4. Quy Mô Đối Tượng Tham Gia', icon: Sliders },
+                    { id: 'drl', label: '5. Tiêu Chí Điểm Rèn Luyện (C.11)', icon: Award },
+                    { id: 'sv5t', label: '6. Tiêu Chuẩn Sinh Viên 5 Tốt (C.12)', icon: CheckSquare },
+                    { id: 'hoi', label: '7. Mảng Công Tác Hội (C.13)', icon: FileText },
+                    { id: 'doan', label: '8. Mảng Công Tác Đoàn (C.14)', icon: FileText },
+                  ].map(cat => {
+                    const IconComponent = cat.icon;
+                    return (
+                      <button
+                        key={cat.id}
+                        type="button"
+                        onClick={() => {
+                          onOpenMenuEditor(cat.id);
+                          setConfigDropdownOpen(false);
+                        }}
+                        className="w-full flex items-center justify-between px-3 py-2 text-xs font-semibold rounded-xl text-slate-700 dark:text-slate-200 hover:bg-amber-50 dark:hover:bg-amber-950/50 hover:text-amber-900 dark:hover:text-amber-200 transition cursor-pointer"
+                      >
+                        <span className="flex items-center gap-2 truncate">
+                          <IconComponent className="w-4 h-4 text-amber-600 dark:text-amber-400 shrink-0" />
+                          <span className="truncate">{cat.label}</span>
+                        </span>
+                        <span className="text-[10px] text-slate-400 font-mono shrink-0">Mở</span>
+                      </button>
+                    );
+                  })}
+                </div>
+              </div>
+            )}
+          </div>
+        )}
+      </div>
+
+      {/* Floating Descriptive Tooltip */}
+      {hoveredNav && tooltipAnchor && (
+        <div
+          role="tooltip"
+          className="fixed z-50 pointer-events-none transition-all duration-150 ease-out animate-in fade-in zoom-in-95"
+          style={{
+            left: `${tooltipAnchor.x}px`,
+            top: `${tooltipAnchor.y}px`,
+            transform: 'translateX(-50%)'
+          }}
+        >
+          <div className="flex justify-center -mb-1">
+            <div className="w-2.5 h-2.5 rotate-45 bg-slate-900 dark:bg-slate-800 border-t border-l border-slate-700/80 dark:border-slate-700 shadow-xs" />
+          </div>
+          <div className="bg-slate-900/95 dark:bg-slate-800/95 text-white border border-slate-700/80 dark:border-slate-700 rounded-xl px-3.5 py-2.5 shadow-2xl shadow-black/50 backdrop-blur-md max-w-xs sm:max-w-sm w-max min-w-[220px]">
+            <div className="flex items-center justify-between gap-2 border-b border-slate-800 dark:border-slate-700/80 pb-1.5 mb-1.5">
+              <span className="font-bold text-xs text-emerald-400 dark:text-emerald-300 flex items-center gap-1.5 truncate">
+                <span>{hoveredNav.label}</span>
+              </span>
+              <span className="text-[10px] bg-emerald-950/80 dark:bg-emerald-900/60 text-emerald-300 border border-emerald-700/50 px-1.5 py-0.5 rounded-md font-mono font-bold shrink-0">
+                {getCanonicalItem(hoveredNav.id)?.badge || 'Phân Hệ'}
+              </span>
+            </div>
+            <p className="text-[11px] text-slate-300 dark:text-slate-200 leading-relaxed font-normal">
+              {hoveredNav.description || getCanonicalItem(hoveredNav.id)?.description}
+            </p>
+          </div>
+        </div>
+      )}
+    </div>
+  );
+};
+
+export default DesktopNavigation;
+
