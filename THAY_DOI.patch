+    }
+    if (propStudent) return propStudent;
+    return students.find(s => s.studentId === selectedStudentId) || activeStudentDefault;
+  }, [propStudent, selectedStudentId, students, activeStudentDefault, user.currentRole.roleLevel, user.studentId]);
+
+  // QR Code Generation state
+  const [qrDataUrl, setQrDataUrl] = useState<string>('');
+  const [sessionToken, setSessionToken] = useState<string>('');
+  const [sessionTimestamp, setSessionTimestamp] = useState<string>('');
+  const [sessionExpirySeconds, setSessionExpirySeconds] = useState<number>(900); // 15 mins expiry
+  const [isGenerating, setIsGenerating] = useState<boolean>(false);
+  const [hasCopied, setHasCopied] = useState<boolean>(false);
+
+  // Attendance Capture State
+  const [isCapturing, setIsCapturing] = useState<boolean>(false);
+  const [capturedRecord, setCapturedRecord] = useState<AttendanceRecord | null>(null);
