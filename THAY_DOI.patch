diff --git a/firestore.rules b/firestore.rules
new file mode 100644
index 0000000..41da380
--- /dev/null
+++ b/firestore.rules
@@ -0,0 +1,338 @@
+rules_version = '2';
+service cloud.firestore {
+  match /databases/{database}/documents {
+
+    // Helper functions for Authentication & RBAC
+    function isSignedIn() {
+      return request.auth != null;
+    }
+
+    function getUserEmail() {
+      return request.auth.token.email.lower();
+    }
+
+    // Kiểm tra tài khoản cán bộ hợp lệ đã được phê duyệt trong hệ thống
+    function hasSystemAccount() {
+      return isSignedIn() &&
+        exists(/databases/$(database)/documents/system_accounts/$(getUserEmail()));
+    }
+
+    function getAccountData() {
+      return get(/databases/$(database)/documents/system_accounts/$(getUserEmail())).data;
+    }
+
+    // Level 4: Ban Thường vụ Đoàn trường / Quản trị viên tối cao (Rely strictly on system_accounts)
+    function isLevel4Admin() {
+      return isSignedIn() &&
+        hasSystemAccount() &&
+        getAccountData().roleLevel == 4 &&
+        getAccountData().status == 'Active';
+    }
+
+    // Level 3: Ban Chấp hành Đoàn Khoa
+    function isStaffLevel3() {
+      return isLevel4Admin() || (
+        hasSystemAccount() &&
+        getAccountData().roleLevel >= 3 &&
+        getAccountData().status == 'Active'
+      );
+    }
+
+    // Level 2: Ban Chấp hành Chi đoàn, Ban Chủ nhiệm CLB/Đội/Nhóm
+    function isStaffLevel2() {
+      return isLevel4Admin() || (
+        hasSystemAccount() &&
+        getAccountData().roleLevel >= 2 &&
+        getAccountData().status == 'Active'
+      );
+    }
+
+    // isStaff(): Đã sửa bảo mật triệt để - KHÔNG cấp quyền cán bộ cho mọi tài khoản Google đăng nhập
+    function isStaff() {
+      return isStaffLevel2();
+    }
+
+    // Mã đơn vị trực thuộc của cán bộ
+    function getStaffOrg() {
+      return hasSystemAccount() ? getAccountData().orgCode : '';
+    }
+
+    // Mã lớp phụ trách của cán bộ chi đoàn
+    function getStaffClass() {
+      return (hasSystemAccount() && ('classCode' in getAccountData())) ? getAccountData().classCode : '';
+    }
+
+    // Kiểm tra sinh viên chính chủ đối soát chính xác theo Firebase UID hoặc email đăng ký chính thức (Loại bỏ hoàn toàn regex substring)
+    function isStudentSelf(studentDoc, studentId) {
+      return isSignedIn() && (
+        ('uid' in studentDoc && studentDoc.uid == request.auth.uid) ||
+        ('userId' in studentDoc && studentDoc.userId == request.auth.uid) ||
+        ('email' in studentDoc && studentDoc.email.lower() == getUserEmail()) ||
+        (getUserEmail() == (studentId.lower() + '@hcmuaf.edu.vn')) ||
+        (getUserEmail() == (studentId.lower() + '@st.hcmuaf.edu.vn'))
+      );
+    }
+
+    function isValidId(id) {
+      return id is string && id.size() > 0 && id.size() <= 128;
+    }
+
+    // Mặc định từ chối mọi truy cập trái phép
+    match /{document=**} {
+      allow read, write: if false;
+    }
+
+    // =========================================================================
+    // 1. ACTIVITIES COLLECTION (HOẠT ĐỘNG ĐOÀN - HỘI & PHÊ DUYỆT ĐA CẤP)
+    // =========================================================================
+    match /activities/{activityId} {
+      allow get, list: if (
+        resource.data.status == 'Approved' &&
+        (!('isDeleted' in resource.data) || resource.data.isDeleted == false) &&
+        (!('deleted' in resource.data) || resource.data.deleted == false)
+      ) || isStaff();
+
+      allow create: if isStaff()
+        && isValidId(activityId)
+        && request.resource.data.id is string
+        && request.resource.data.title is string
+        && request.resource.data.title.size() > 0
+        && request.resource.data.orgCode is string
+        && (
+          isLevel4Admin() ||
+          request.resource.data.status in ['Pending_L3', 'Pending_L4', 'Request_Edit', 'Rejected']
+        );
+
+      function isValidActivityTransition(existingStatus, incomingStatus) {
+        return (
+          isLevel4Admin() ||
+          (isStaffLevel3() && (
+            (existingStatus == 'Pending_L3' && incomingStatus in ['Pending_L4', 'Request_Edit', 'Rejected']) ||
+            (existingStatus == 'Request_Edit' && incomingStatus == 'Pending_L4') ||
+            (existingStatus == incomingStatus)
+          )) ||
+          (isStaffLevel2() && (
+            (existingStatus == 'Request_Edit' && incomingStatus in ['Pending_L3', 'Pending_L4']) ||
+            (existingStatus == incomingStatus && (existingStatus == 'Pending_L3' || existingStatus == 'Request_Edit'))
+          ))
+        );
+      }
+
+      allow update: if isStaff()
+        && isValidId(activityId)
+        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'createdAt'])
+        && (
+          isLevel4Admin() || (
+            (!('isLocked' in resource.data) || resource.data.isLocked == false) &&
+            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orgCode']) &&
+            isValidActivityTransition(resource.data.status, request.resource.data.status) &&
+            (
+              (isStaffLevel3() && resource.data.orgCode == getStaffOrg()) ||
+              (isStaffLevel2() && resource.data.orgCode == getStaffOrg() && ('branchClass' in resource.data && resource.data.branchClass == getStaffClass()))
+            )
+          )
+        );
+
+      allow delete: if isLevel4Admin() && isValidId(activityId);
+    }
+
+    // =========================================================================
+    // 2. STUDENTS COLLECTION (HỒ SƠ & ĐIỂM RÈN LUYỆN SINH VIÊN BẢO MẬT)
+    // =========================================================================
+    match /students/{studentId} {
+      allow get: if isLevel4Admin() ||
+        (isStaffLevel3() && resource.data.facultyCode == getStaffOrg()) ||
+        (isStaffLevel2() && (resource.data.classCode == getStaffClass() || resource.data.facultyCode == getStaffOrg())) ||
+        isStudentSelf(resource.data, studentId);
+
+      // Giới hạn query/list theo phạm vi trường (L4), khoa (L3), lớp (L2) hoặc chính chủ
+      allow list: if isSignedIn() && (
+        isLevel4Admin() ||
+        (isStaffLevel3() && resource.data.facultyCode == getStaffOrg()) ||
+        (isStaffLevel2() && resource.data.classCode == getStaffClass()) ||
+        isStudentSelf(resource.data, studentId)
+      );
+
+      allow create: if isValidId(studentId)
+        && (
+          isLevel4Admin() ||
+          (isStaffLevel3() && request.resource.data.facultyCode == getStaffOrg()) ||
+          (isStaffLevel2() && request.resource.data.classCode == getStaffClass())
+        )
+        && request.resource.data.studentId is string
+        && request.resource.data.studentId.size() > 0
+        && request.resource.data.fullName is string
+        && request.resource.data.classCode is string
+        && request.resource.data.facultyCode is string
+        && (!('totalScore' in request.resource.data) || (request.resource.data.totalScore >= 0 && request.resource.data.totalScore <= 100));
+
+      allow update: if isValidId(studentId)
+        && request.resource.data.studentId == resource.data.studentId
+        && (!('totalScore' in request.resource.data) || (request.resource.data.totalScore >= 0 && request.resource.data.totalScore <= 100))
+        && (
+          (isLevel4Admin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'id', 'createdAt'])) ||
+          (isStaffLevel3() && resource.data.facultyCode == getStaffOrg() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'id', 'createdAt', 'facultyCode', 'classCode', 'uid', 'userId', 'email'])) ||
+          (isStaffLevel2() && resource.data.classCode == getStaffClass() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['studentId', 'id', 'createdAt', 'facultyCode', 'classCode', 'uid', 'userId', 'email'])) ||
+          (
+            isStudentSelf(resource.data, studentId) &&
+            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
+              'selfProofs', 'phone', 'avatarUrl', 'updatedAt'
+            ])
+          )
+        );
+
+      allow delete: if isLevel4Admin() && isValidId(studentId);
+    }
+
+    // =========================================================================
+    // 3. SYSTEM ACTIVITY LOGS (NHẬT KÝ HỆ THỐNG - CHỐNG GIẢ MẠO)
+    // =========================================================================
+    match /system_activity_logs/{logId} {
+      allow get, list: if isLevel4Admin();
+      allow create: if isSignedIn()
+        && isValidId(logId)
+        && request.resource.data.category is string
+        && request.resource.data.actionTitle is string
+        && request.resource.data.performedBy is map
+        && request.resource.data.performedBy.userEmail.lower() == getUserEmail();
+      allow update, delete: if false;
+    }
+
+    // =========================================================================
+    // 4. SCORE AUDIT LOGS (VẾT KIỂM TOÁN ĐIỂM - CHỐNG GIẢ MẠO)
+    // =========================================================================
+    match /score_audit_logs/{logId} {
+      allow get, list: if isStaff() || (isSignedIn() && isStudentSelf(resource.data, resource.data.studentId));
+      allow create: if isStaff()
+        && isValidId(logId)
+        && request.resource.data.studentId is string
+        && request.resource.data.performedBy is map
+        && request.resource.data.performedBy.userEmail.lower() == getUserEmail();
+      allow update, delete: if false;
+    }
+
+    // =========================================================================
+    // 5. SYSTEM ACCOUNTS (PHÂN QUYỀN VAI TRÒ CÁN BỘ - RBAC)
+    // =========================================================================
+    match /system_accounts/{accountId} {
+      allow get: if isLevel4Admin() || (isSignedIn() && getUserEmail() == accountId.lower());
+      allow list: if isLevel4Admin();
+      allow create, update, delete: if isLevel4Admin() && isValidId(accountId);
+    }
+
+    // =========================================================================
+    // 6. ISSUED CERTIFICATES (GIẤY CHỨNG NHẬN ĐIỆN TỬ - BẢO VỆ TRA CỨU)
+    // =========================================================================
+    match /issued_certificates/{certId} {
+      // Xác thực riêng tư cho tài khoản đã đăng nhập trong hệ thống
+      allow get: if isSignedIn();
+      // Danh sách chỉ dành cho Cán bộ hoặc sinh viên sở hữu chứng nhận
+      allow list: if isStaff() || (
+        isSignedIn() && (
+          resource.data.studentId == request.auth.uid ||
+          ('uid' in resource.data && resource.data.uid == request.auth.uid) ||
+          ('studentEmail' in resource.data && resource.data.studentEmail.lower() == getUserEmail()) ||
+          (getUserEmail() == (resource.data.studentId.lower() + '@hcmuaf.edu.vn')) ||
+          (getUserEmail() == (resource.data.studentId.lower() + '@st.hcmuaf.edu.vn'))
+        )
+      );
+      allow create, update, delete: if isStaffLevel3() && isValidId(certId);
+    }
+
+    // =========================================================================
+    // 7. SYSTEM META & CONFIGURATION (CẤU HÌNH GIAO DIỆN & DANH MỤC TỪ NGỮ)
+    // =========================================================================
+    match /system_meta/{metaDocId} {
+      allow read: if isSignedIn();
+      allow write: if isLevel4Admin();
+    }
+
+    // =========================================================================
+    // 8. ATTENDANCE RECORDS (ĐIỂM DANH HOẠT ĐỘNG QUA MÃ QR & PHIÊN LÀM VIỆC)
+    // =========================================================================
+    match /attendance_records/{attendanceId} {
+      // Đọc bản ghi: Cán bộ hoặc sinh viên chính chủ
+      allow get: if isStaff() || (
+        isSignedIn() && (
+          resource.data.studentId == request.auth.uid ||
+          (getUserEmail() == (resource.data.studentId.lower() + '@hcmuaf.edu.vn')) ||
+          (getUserEmail() == (resource.data.studentId.lower() + '@st.hcmuaf.edu.vn')) ||
+          ('uid' in resource.data && resource.data.uid == request.auth.uid)
+        )
+      );
+
+      // Tra cứu danh sách: Cán bộ hoặc sinh viên chính chủ lọc theo MSSV/UID
+      allow list: if isStaff() || (
+        isSignedIn() && (
+          resource.data.studentId == request.auth.uid ||
+          (getUserEmail() == (resource.data.studentId.lower() + '@hcmuaf.edu.vn')) ||
+          (getUserEmail() == (resource.data.studentId.lower() + '@st.hcmuaf.edu.vn')) ||
+          ('uid' in resource.data && resource.data.uid == request.auth.uid)
+        )
+      );
+
+      // Điểm danh (Create): Cán bộ hoặc chính sinh viên quét mã QR điểm danh
+      allow create: if isSignedIn()
+        && isValidId(attendanceId)
+        && request.resource.data.activityId is string
+        && request.resource.data.studentId is string
+        && request.resource.data.checkInTimestamp is string
+        && ('createdAtServer' in request.resource.data && request.resource.data.createdAtServer == request.time)
+        && attendanceId == request.resource.data.activityId + "_" + request.resource.data.studentId
+        && exists(/databases/$(database)/documents/students/$(request.resource.data.studentId))
+        && exists(/databases/$(database)/documents/activities/$(request.resource.data.activityId))
+        && get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.status == 'Approved'
+        && (!('isDeleted' in get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data) || get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.isDeleted == false)
+        && (!('deleted' in get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data) || get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.deleted == false)
+        && (
+          isStaff() ||
+          isStudentSelf(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data, request.resource.data.studentId)
+        );
+
+      // Cập nhật trạng thái điểm danh: Theo đúng phạm vi quản lý và không cho sửa đổi thông tin định danh
+      allow update: if isValidId(attendanceId)
+        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'studentId', 'activityId', 'createdAt', 'createdAtServer', 'recordedBy'])
+        && (
+          isLevel4Admin() ||
+          (isStaffLevel3() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.facultyCode == getStaffOrg()) ||
+          (isStaffLevel2() && get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.classCode == getStaffClass())
+        );
+
+      // Xóa bản ghi điểm danh: Chỉ Quản trị viên Cấp 4
+      allow delete: if isLevel4Admin() && isValidId(attendanceId);
+    }
+
+    // =========================================================================
+    // 9. TARGETS COLLECTION (DANH MỤC CHỈ TIÊU & PHÂN BỔ ĐA TẦNG)
+    // =========================================================================
+    match /targets/{targetId} {
+      // Đọc chỉ tiêu: Tất cả tài khoản đã đăng nhập trong hệ thống
+      allow get, list: if isSignedIn();
+
+      // Khởi tạo chỉ tiêu mới: Cấp 4 (Trường) hoặc Cấp 3 (Đoàn Khoa)
+      allow create: if (isLevel4Admin() || isStaffLevel3())
+        && isValidId(targetId)
+        && request.resource.data.id is string
+        && request.resource.data.code is string
+        && request.resource.data.name is string
+        && request.resource.data.targetValue is number;
+
+      // Cập nhật chỉ tiêu / phân bổ / tiến độ:
+      allow update: if isValidId(targetId) && (
+        isLevel4Admin() ||
+        (
+          isStaff() &&
+          (!('isLocked' in resource.data) || resource.data.isLocked == false) &&
+          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['id', 'code', 'name', 'category', 'targetValue', 'academicYear', 'level', 'createdAt', 'isLocked']) &&
+          (
+            isStaffLevel3() && (resource.data.level in ['KHOA', 'CHI_DOAN_CLB']) ||
+            (isStaffLevel2() && resource.data.level == 'CHI_DOAN_CLB')
+          )
+        )
+      );
+
+      // Xóa chỉ tiêu: Chỉ Ban Thường vụ Đoàn trường (Cấp 4)
+      allow delete: if isLevel4Admin() && isValidId(targetId);
+    }
+  }
+}
