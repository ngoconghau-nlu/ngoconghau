+
+  // Activity & Student selection state (if not passed as props)
+  const approvedActivities = useMemo(() => {
+    return activities.filter(a => a.status === 'Approved' && !a.isDeleted && !a.deleted);
+  }, [activities]);
+
+  const [selectedActivityId, setSelectedActivityId] = useState<string>(
+    propActivity?.id || approvedActivities[0]?.id || ''
+  );
+
+  // Determine active student: prop -> selectedPortalStudentId -> current logged in student -> first student
+  const activeStudentDefault = useMemo(() => {
+    // Stage 2, Rule 4: If regular student (L1), force they can only access their own record
+    if (user.currentRole.roleLevel === 1 && user.studentId) {
+      return students.find(s => s.studentId === user.studentId) || null;
+    }
+
+    if (propStudent) return propStudent;
+    if (selectedPortalStudentId) {
+      const found = students.find(s => s.studentId === selectedPortalStudentId);
+      if (found) return found;
+    }
+    if (user.studentId) {
+      const found = students.find(s => s.studentId === user.studentId);
+      if (found) return found;
+    }
+    if (user.email) {
+      const emailMatch = students.find(s => s.email && s.email.toLowerCase().trim() === user.email.toLowerCase().trim());
+      if (emailMatch) return emailMatch;
+    }
+    return null;
+  }, [propStudent, selectedPortalStudentId, user.studentId, user.email, students, user.currentRole.roleLevel]);
+
+  const [selectedStudentId, setSelectedStudentId] = useState<string>(
+    activeStudentDefault?.studentId || ''
+  );
+
+  const currentActivity = useMemo(() => {
+    if (propActivity) return propActivity;
+    return activities.find(a => a.id === selectedActivityId) || approvedActivities[0] || null;
