+console.log(`Summary: ${result.passed}/${result.total} tests passed.`);
+if (result.failed > 0) {
+  console.error('\n❌ SOME TESTS FAILED:\n');
+  result.tests.forEach(t => {
+    if (!t.passed) {
+      console.error(`- [FAIL] ${t.name}`);
+    } else {
+      console.log(`- [PASS] ${t.name}`);
+    }
+  });
+  process.exit(1);
+} else {
