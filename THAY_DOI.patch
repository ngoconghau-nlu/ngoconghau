+export function calculateRankGrade(totalScore: number, academicYearNumber: number): 'Hoàn thành xuất sắc nhiệm vụ' | 'Hoàn thành tốt nhiệm vụ' | 'Hoàn thành nhiệm vụ' | 'Không hoàn thành nhiệm vụ' {
+  if (academicYearNumber === 1) {
+    if (totalScore >= 51) return 'Hoàn thành xuất sắc nhiệm vụ';
+    if (totalScore >= 31) return 'Hoàn thành tốt nhiệm vụ';
+    if (totalScore >= 16) return 'Hoàn thành nhiệm vụ';
+    return 'Không hoàn thành nhiệm vụ';
+  } else {
+    if (totalScore >= 61) return 'Hoàn thành xuất sắc nhiệm vụ';
+    if (totalScore >= 41) return 'Hoàn thành tốt nhiệm vụ';
+    if (totalScore >= 21) return 'Hoàn thành nhiệm vụ';
+    return 'Không hoàn thành nhiệm vụ';
+  }
+}
+
+/**
+ * Xếp loại thi đua rèn luyện chung 5 mức quy chuẩn:
+ * Xuất sắc, Tốt, Khá, Trung bình, Yếu
+ */
+export function calculateGeneralRank(totalScore: number): 'Xuất sắc' | 'Tốt' | 'Khá' | 'Trung bình' | 'Yếu' {
+  if (totalScore >= 90) return 'Xuất sắc';
+  if (totalScore >= 80) return 'Tốt';
+  if (totalScore >= 65) return 'Khá';
+  if (totalScore >= 50) return 'Trung bình';
+  return 'Yếu';
+}
