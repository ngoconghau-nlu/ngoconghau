+    // Unique session token with timestamp and entropy
+    const token = `nlu_chk_${currentStudent.studentId}_${currentActivity.id}_${Date.now()}_${Math.random().toString(36).substring(2, 8).toUpperCase()}`;
+
+    setSessionToken(token);
