+  totalMembers: number; // Tổng số sinh viên
+  totalDoanVien: number; // Tổng số đoàn viên (thống kê tại danh mục sinh viên)
+  totalHoiVien: number; // Số lượng hội viên
+  totalSinhVien: number; // Số lượng sinh viên khác
