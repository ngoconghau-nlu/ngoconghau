+      font-weight: bold;
+      text-align: center;
+      margin-top: 2px;
+    }
+    .line-divider {
+      width: 120px;
+      height: 1px;
+      background: #111827;
+      margin: 4px auto 0 auto;
+    }
+    .doc-number {
+      font-size: 9pt;
+      margin-top: 4px;
+      text-align: center;
+      font-style: italic;
+    }
+    .date-line {
+      font-size: 9.5pt;
+      font-style: italic;
+      text-align: center;
+      margin-top: 4px;
+    }
+    .report-title-container {
+      text-align: center;
+      margin: 16px 0 12px 0;
+    }
+    .main-title {
+      font-size: 14pt;
+      font-weight: bold;
+      text-transform: uppercase;
+      color: #047857;
+      margin: 0;
+    }
+    .sub-title-info {
+      font-size: 10.5pt;
+      font-weight: bold;
+      color: #374151;
+      margin-top: 4px;
+    }
+    .scope-info {
+      font-size: 9.5pt;
+      font-style: italic;
+      color: #6b7280;
+      margin-top: 2px;
+    }
+    .summary-box {
+      border: 1px solid #cbd5e1;
+      background: #f8fafc;
+      border-radius: 6px;
+      padding: 8px 12px;
+      margin-bottom: 12px;
+    }
+    .summary-title {
+      font-size: 9pt;
+      font-weight: bold;
+      color: #0f172a;
+      text-transform: uppercase;
+      margin-bottom: 6px;
+      letter-spacing: 0.5px;
+    }
+    .summary-grid {
+      display: flex;
+      flex-wrap: wrap;
+      gap: 10px;
+    }
+    .summary-card {
+      flex: 1;
+      min-width: 110px;
+      background: #ffffff;
+      border: 1px solid #e2e8f0;
+      border-radius: 4px;
+      padding: 6px 8px;
+      text-align: center;
+    }
+    .stat-label {
+      font-size: 8.5pt;
+      color: #475569;
+      font-weight: bold;
+    }
+    .stat-value {
+      font-size: 13pt;
+      font-weight: bold;
+      color: #047857;
+      margin: 2px 0;
+    }
+    .stat-note {
+      font-size: 7.5pt;
+      color: #64748b;
+    }
+    .data-table {
+      width: 100%;
+      border-collapse: collapse;
+      font-size: 9pt;
+      margin-bottom: 16px;
+    }
+    .data-table th, .data-table td {
+      border: 1px solid #94a3b8;
+      padding: 5px 6px;
+    }
+    .data-table th {
+      background: #e2e8f0;
+      color: #0f172a;
+      font-weight: bold;
