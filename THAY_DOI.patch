+export function checkSv5tEligibility(achievedMap: Record<string, boolean>): {
+  isEligible: boolean;
+  totalRequired: number;
+  totalAchieved: number;
+  percent: number;
+} {
+  let totalRequired = 0;
+  let totalAchieved = 0;
+
+  SV5T_STANDARDS.forEach(std => {
+    std.criteria.forEach(c => {
+      totalRequired++;
+      if (achievedMap[c.id]) {
+        totalAchieved++;
+      }
+    });
+  });
+
+  const percent = totalRequired > 0 ? Math.round((totalAchieved / totalRequired) * 100) : 0;
+  const isEligible = totalAchieved === totalRequired && totalRequired > 0;
+
+  return { isEligible, totalRequired, totalAchieved, percent };
+}
