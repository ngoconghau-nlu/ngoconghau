+    return rows;
+  }, [organizations, activities, students]);
+
+  // Lọc dữ liệu theo Danh mục (CLB, Tổ, Đội, Nhóm), Phân cấp, Khoa, Danh hiệu & Tìm kiếm
+  const filteredRows = useMemo(() => {
+    return clubEmulationData.filter(r => {
