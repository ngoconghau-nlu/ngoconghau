+export function getPointsForRole(role: ParticipantRoleType, programLevel: number): number {
+  const entry = ROLE_POINTS_MATRIX[role] || ROLE_POINTS_MATRIX['Tham dự'];
+  if (programLevel === 1) return entry.c1;
+  if (programLevel === 2) return entry.c2;
+  if (programLevel === 3) return entry.c3;
+  return entry.c4;
+}
