+import React, { useMemo } from 'react';
+import { useApp } from '../context/AppContext';
+import {
+  Calendar,
+  CheckCircle,
+  Clock,
+  XCircle,
+  Users,
+  Trophy,
+  Award,
+  TrendingUp,
+  FileCheck,
+  ChevronRight,
+  ShieldAlert,
