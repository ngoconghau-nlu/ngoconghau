+function isChiDoanOrClubRole(userRole?: UserRole): boolean {
+  if (!userRole) return true;
+  if (userRole.roleLevel <= 2) return true; // Level 0 (Guest), 1 (Student), 2 (Chi đoàn / Tổ / Đội / Nhóm)
