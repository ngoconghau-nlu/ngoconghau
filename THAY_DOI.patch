+                </div>
+              </div>
+
+              <button
+                type="button"
+                onClick={() => setShowIOSGuide(false)}
+                className="mt-5 w-full rounded-2xl bg-emerald-600 hover:bg-emerald-700 py-3 text-sm font-bold text-white shadow-md shadow-emerald-600/25 transition cursor-pointer"
